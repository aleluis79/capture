{
  "name": "captura",
  "productName": "Captura",
  "version": "0.1.0",
  "description": "Grabador de pantalla simple para Linux y Windows",
  "main": "./out/main/index.js",
  "author": {
    "name": "Alejandro",
    "email": "ale.luis@gmail.com"
  },
  "homepage": "https://github.com/aleluis79/capture",
  "desktopName": "captura.desktop",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-binaries.mjs",
    "dev": "node scripts/electron-vite-run.mjs dev",
    "start": "node scripts/electron-vite-run.mjs preview",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/smoke.mjs && node tests/e2e/pipeline.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:linux": "pnpm build && electron-builder --linux",
    "build:win": "pnpm build && electron-builder --win"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.4.1"
}
